# Public URL of the backend; in development use http://localhost:8787
APP_BASE_URL=http://localhost:8787
FRONTEND_ORIGIN=http://localhost:5173
# Zoho API region base. Confirm the account's data center; examples: https://mail.zoho.com, https://mail.zoho.eu
ZOHO_API_BASE=https://mail.zoho.com
# OAuth authorization/token host for the account's data center; examples: https://accounts.zoho.com, https://accounts.zoho.eu
ZOHO_ACCOUNTS_BASE=https://accounts.zoho.com
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Generate 32 random bytes and base64-encode. Used to encrypt local token storage.
TOKEN_ENCRYPTION_KEY=
# Optional strict allowed sender; defaults to developer@lucion.kro.kr
ALLOWED_FROM=developer@lucion.kro.kr
# Optional cookie signing secret; use a long random value
SESSION_SECRET=
# Production: set NODE_ENV=production and serve over HTTPS
NODE_ENV=development
PORT=8787
# Frontend build-time public API URL; leave blank when a same-origin /api proxy is used
VITE_API_BASE=
